#!/usr/bin/env bash
#MISE hide=true
set -Eeuo pipefail

gjc setup paseo
paseo daemon restart

ps -Ao pid,command | grep 'sdk broker-internal' | grep -v grep | \
while read pid rest; do
	d=$(echo "$rest" | grep -oE 'npm-gajae-code/[^/]+/' | head -1)
	[ -d "${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs/$d" ] && s=OK || s=MISSING
	echo "pid $pid -> $d [$s]"
done
