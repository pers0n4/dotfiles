#!/usr/bin/env bash
#MISE hide=true
set -Eeuo pipefail

claude mcp add --scope=user codex codex mcp-server
claude mcp add --scope=user ir ir mcp
claude mcp add --scope=user --transport http context7 https://mcp.context7.com/mcp --header "Authorization: Bearer $CONTEXT7_API_KEY"
claude mcp add --scope=user basic-memory -- uvx basic-memory mcp

codex mcp add ir -- ir mcp
codex mcp add context7 --url https://mcp.context7.com/mcp --bearer-token-env-var CONTEXT7_API_KEY
codex mcp add basic-memory bash -c "uvx basic-memory mcp"
