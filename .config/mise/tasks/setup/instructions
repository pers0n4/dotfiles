#!/usr/bin/env bash
#MISE hide=true
set -Eeuo pipefail

src="$HOME/iCloud/git/dotfiles/.gjc/agent"
dst="$HOME/.gjc/agent"
mkdir -p "$dst"

# AGENTS.md·APPEND_SYSTEM.md: ~/iCloud 기준 심볼릭 링크. 기존 일반 파일은 덮어쓰지 않고 중단
for f in AGENTS.md APPEND_SYSTEM.md; do
  if [[ -e "$dst/$f" && ! -L "$dst/$f" ]]; then
    echo "FAIL $dst/$f is a regular file; resolve manually" >&2
    exit 1
  fi
  ln -sfn "$HOME/iCloud/git/dotfiles/.gjc/agent/$f" "$dst/$f"
done

# RULES.md: GJC가 외부 링크를 읽지 않으므로 일반 파일로 복사
rm -f "$dst/RULES.md.tmp"
cp "$src/RULES.md" "$dst/RULES.md.tmp"
mv "$dst/RULES.md.tmp" "$dst/RULES.md"

cmp -s "$src/RULES.md" "$dst/RULES.md"
echo "OK agent instructions"
