#!/bin/sh
# AI 공동작성자 이름이 정규화 형식과 다를 때만 경고한다. 메시지 수정·모델 신원 확인·커밋 차단은 하지 않는다.
# 전역 git 설정의 hook.commit-msg-coauthor-lint(commit-msg)로 실행되며, 저장소 hook과 별개로 함께 실행된다.
if ! command -v python3 >/dev/null; then
    printf '%s\n' '경고: python3가 없어 AI 공동작성자 이름 검사를 건너뜁니다.' >&2
else
python3 - "$@" <<'PY'
import re
import subprocess
import sys


def warn(message):
    print(f"경고: {message}", file=sys.stderr)


def inspect():
    if len(sys.argv) != 2:
        warn("commit-msg 메시지 파일 인자가 잘못되어 AI 공동작성자 이름 검사를 건너뜁니다.")
        return
    parsed = subprocess.run(
        ["git", "interpret-trailers", "--parse", "--", sys.argv[1]],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        check=False,
    )
    if parsed.returncode != 0:
        warn("Git trailer를 읽지 못해 AI 공동작성자 이름 검사를 건너뜁니다.")
        return

    claude = re.compile(r"Claude (?:Opus|Sonnet|Haiku|Fable) [0-9]+(?:\.[0-9]+)?")
    gpt = re.compile(
        r"GPT-[0-9]+(?:\.[0-9]+)?(?: (?:Sol|Luna|Astra|Codex|Mini|Nano|Pro))*"
    )
    ai_prefix = re.compile(r"^(?:GPT|Claude|Anthropic|GJC|Codex)(?:\b|[-_:])", re.IGNORECASE)
    ai_emails = {"codex@openai.com", "noreply@openai.com", "noreply@anthropic.com"}

    for line in parsed.stdout.splitlines():
        token, separator, value = line.partition(":")
        if not separator or token.strip().lower() != "co-authored-by":
            continue
        value = value.strip()
        identity = re.fullmatch(r"(.*?)\s*<([^<>]+)>", value)
        name = identity.group(1).strip() if identity else value
        email = identity.group(2).strip().lower() if identity else None
        if email not in ai_emails and not ai_prefix.match(name):
            continue
        if claude.fullmatch(name) or gpt.fullmatch(name):
            continue
        # repr로 제어 문자를 이스케이프해 터미널 제어 시퀀스를 그대로 출력하지 않는다.
        warn(
            f"Co-authored-by의 AI 모델명 {name!r}이 정규화 형식과 다릅니다. "
            "Claude Opus 5.5 또는 GPT-6.1 Sol 같은 형식을 사용하십시오. "
            "이 hook은 커밋을 차단하지 않습니다."
        )


try:
    inspect()
except Exception:
    warn("AI 공동작성자 이름 검사에 오류가 발생했습니다. 이 hook은 커밋을 차단하지 않습니다.")
PY
fi

# 검사 실패나 런타임 오류가 있어도 이 경고 전용 hook은 커밋을 차단하지 않는다.
exit 0
