#!/bin/sh
# Git pre-push supplies one local/remote ref and object-ID pair per line.
blocked=0
while read -r _local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;; # Branch deletion.
    esac

    # For an existing branch, exclude only its advertised old history.
    # The old tip need not be an ancestor of the new tip (force push).
    set -- "$local_oid"
    case "$remote_oid" in
        *[!0]*) set -- "$@" "^$remote_oid" ;;
    esac

    subjects=$(git --no-replace-objects log --format='%h %s' "$@" --) || {
        printf '[ERROR] pre-push-autosquash-lint: %s의 푸시 이력을 검사할 수 없습니다. 원격 이력을 fetch한 뒤 다시 시도하세요.\n' "$remote_ref" >&2
        exit 1
    }
    matches=$(printf '%s\n' "$subjects" | LC_ALL=C awk '/^[0-9a-f]+ (fixup|squash|amend)! /')
    if [ -n "$matches" ]; then
        printf '[ERROR] pre-push-autosquash-lint: %s에 autosquash 커밋이 남아 있습니다.\n' "$remote_ref" >&2
        printf '%s\n' "$matches" | awk '{ print "  " $0 }' >&2
        blocked=1
    fi
done

if [ "$blocked" -ne 0 ]; then
    printf '%s\n' '  git rebase --autosquash로 커밋을 정리한 뒤 다시 푸시하세요.' >&2
fi
exit "$blocked"
