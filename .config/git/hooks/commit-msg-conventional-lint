#!/bin/sh
# 커밋 메시지가 Conventional Commits 1.0.0과 .agents/references/git.md 규칙을 따르지 않으면 커밋을 차단한다.
# 전역 git 설정의 hook.commit-msg-conventional-lint(commit-msg)로 실행되며, 저장소 hook과 별개로 함께 실행된다.
# 검사를 건너뛰려면 git commit --no-verify를 사용한다. 이 옵션은 저장소의 commit-msg·pre-commit hook도 함께 건너뛴다.
if ! command -v python3 >/dev/null; then
    printf '%s\n' '[WARN] commit-msg-conventional-lint: python3가 없어 Conventional Commits 검사를 건너뜁니다.' >&2
    exit 0
fi

exec python3 - "$@" <<'PY'
import re
import subprocess
import sys

TYPES = ("feat", "fix", "revert", "refactor", "test", "docs", "chore", "style", "perf", "build", "ci")
HEADER = re.compile(
    r"(?P<type>[^(!:\s]+)(?:\((?P<scope>[^()]*)\))?(?P<breaking>!)?: (?P<description>\S.*)"
)
# Conventional Commits는 scope의 대소문자를 정하지 않으므로 저장소 규칙의 camelCase scope(예: meatStation)도 허용한다.
SCOPE = re.compile(r"[A-Za-z0-9]+(?:[-_./][A-Za-z0-9]+)*")
SCISSORS = re.compile(r"^\S+ -{24} >8 -{24}$")
BREAKING_FOOTER = re.compile(r"^BREAKING[ -]CHANGE: \S")
BREAKING_LIKE = re.compile(r"^breaking[ -]changes?\s*:", re.IGNORECASE)
# autosquash 접두사만 검사하지 않는다. 로컬 merge commit도 검사하므로 git merge -m으로 형식에 맞는 메시지를 지정한다.
# GitHub에서 생성하는 merge commit은 로컬 hook이 실행되지 않으므로 PR 제목 규칙으로 지정한다.
EXEMPT = re.compile(r"^(?:fixup|squash|amend)! ")


def fail(errors, header):
    print(
        "[ERROR] commit-msg-conventional-lint: "
        f"커밋 메시지가 Conventional Commits 규칙을 따르지 않습니다: {header!r}",
        file=sys.stderr,
    )
    for error in errors:
        print(f"  - {error}", file=sys.stderr)
    print("  형식: <type>[(<scope>)][!]: <description>", file=sys.stderr)
    print(f"  허용 type: {', '.join(TYPES)}", file=sys.stderr)
    sys.exit(1)


def read_message(path):
    with open(path, encoding="utf-8", errors="replace") as file:
        lines = file.read().splitlines()
    # commit.verbose의 diff는 scissors 줄 아래에 있으므로 검사에서 제외한다.
    for index, line in enumerate(lines):
        if SCISSORS.match(line):
            lines = lines[:index]
            break
    # core.commentChar를 따르는 주석 제거와 공백 정리는 git stripspace에 맡긴다.
    cleaned = subprocess.run(
        ["git", "stripspace", "--strip-comments"],
        input="\n".join(lines) + "\n",
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        check=True,
    )
    return cleaned.stdout.splitlines()


def main():
    if len(sys.argv) != 2:
        print("[ERROR] commit-msg-conventional-lint: 커밋 메시지 파일 인자가 잘못되었습니다.", file=sys.stderr)
        sys.exit(1)
    lines = read_message(sys.argv[1])
    if not lines:
        # 빈 메시지는 git이 직접 커밋을 중단한다.
        return
    header = lines[0]
    if EXEMPT.match(header):
        return

    errors = []
    match = HEADER.fullmatch(header)
    if not match:
        errors.append("제목은 '<type>[(<scope>)][!]: <description>' 형식이어야 합니다(콜론 뒤 공백 1개).")
    else:
        if match["type"] not in TYPES:
            errors.append(f"type {match['type']!r}은 허용 목록에 없습니다(영어 소문자).")
        scope = match["scope"]
        if scope is not None and not SCOPE.fullmatch(scope):
            errors.append(f"scope {scope!r}은 영문·숫자와 - _ . / 구분자만 사용할 수 있습니다.")
    if len(lines) > 1 and lines[1].strip():
        errors.append("제목과 본문 사이에는 빈 줄이 있어야 합니다.")

    body = lines[1:]
    if any(BREAKING_LIKE.match(line) and not BREAKING_FOOTER.match(line) for line in body):
        errors.append("Breaking change footer는 'BREAKING CHANGE: <내용>'처럼 대문자 token을 사용해야 합니다.")
    if match and not match["breaking"] and any(BREAKING_FOOTER.match(line) for line in body):
        errors.append("BREAKING CHANGE footer가 있으면 제목의 콜론 바로 앞에 '!'를 붙여야 합니다.")

    if errors:
        fail(errors, header)


main()
PY
